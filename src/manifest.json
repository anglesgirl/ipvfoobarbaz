{
  "name": "IPvFooBarBaz",
  "manifest_version": 3,
  "version": "2.21",
  "description": "显示服务器 IP 地址，实时汇总所有页面元素的 IPv4、IPv6、ASN、主机名与 HTTPS 信息，并标注每条连接的 TCP / UDP 协议。",
  "homepage_url": "https://github.com/ziad8727/ipvfoobarbaz",
  "icons": {
    "16": "icon16.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_icon": {
      "16": "icon16_transparent.png"
    }
  },
  "options_ui": {
    "page": "options.html"
  },
  "permissions": [
    "storage",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
