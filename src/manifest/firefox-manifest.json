{
  "name": "IPvFooBarBaz",
  "manifest_version": 3,
  "version": "2.20",
  "description": "Display the server IP address, with a realtime summary of IPv4, IPv6, ASN, hostname, and HTTPS information across all page elements.",
  "homepage_url": "https://github.com/ziad8727/ipvfoobarbaz",
  "icons": {
    "16": "icon16.png",
    "128": "icon128.png"
  },
  "background": {
    "scripts": ["common.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ifbb@ziad87.net",
      "strict_min_version": "115.0"
    },
    "gecko_android": {
      "id": "ifbb@ziad87.net",
      "strict_min_version": "120.0"
    }
  },
  "page_action": {
    "default_icon": {
      "16": "icon16_transparent.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": false
  },
  "permissions": [
    "storage",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
